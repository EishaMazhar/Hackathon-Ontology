    <!-- http://example.org/hackathon#DataScienceTeam -->

    <owl:Class rdf:about="http://example.org/hackathon#DataScienceTeam">
        <rdfs:subClassOf rdf:resource="http://example.org/hackathon#Team"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/hackathon#hasParticipant"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/hackathon#Participant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://example.org/hackathon#Hackathon -->

    <owl:Class rdf:about="http://example.org/hackathon#Hackathon">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/hackathon#hasTeam"/>
                <owl:someValuesFrom rdf:resource="http://example.org/hackathon#Team"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/hackathon#organizedBy"/>
                <owl:someValuesFrom rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="http://example.org/hackathon#Participant"/>
        <owl:disjointWith rdf:resource="http://example.org/hackathon#Project"/>
        <owl:disjointWith rdf:resource="http://example.org/hackathon#Skill"/>
        <owl:disjointWith rdf:resource="http://example.org/hackathon#Team"/>
        <owl:disjointWith rdf:resource="http://example.org/hackathon#Topic"/>
    </owl:Class>
    


