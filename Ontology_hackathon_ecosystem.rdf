<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/hackathon#"
     xml:base="http://example.org/hackathon"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:ns2="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:hack="http://example.org/hackathon#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://example.org/hackathon">
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
        <rdfs:comment>An OWL ontology for hackathons, teams, projects, skills, topics, and awards, reusing FOAF and SKOS.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2002/07/owl#minQualifiedCardinality -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#minQualifiedCardinality"/>
    


    <!-- http://xmlns.com/foaf/0.1/homepage -->

    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/homepage"/>
    


    <!-- http://xmlns.com/foaf/0.1/name -->

    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/hackathon#hasAward -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#hasAward">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Project"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Award"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#hasParticipant -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#hasParticipant">
        <owl:inverseOf rdf:resource="http://example.org/hackathon#memberOfTeam"/>
        <rdfs:domain rdf:resource="http://example.org/hackathon#Team"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Participant"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#hasSkill -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#hasSkill">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Participant"/>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Skill"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#hasTeam -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#hasTeam">
        <owl:inverseOf rdf:resource="http://example.org/hackathon#isTeamOf"/>
        <rdfs:domain rdf:resource="http://example.org/hackathon#Hackathon"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Team"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#hasTopic -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#hasTopic">
        <rdfs:range rdf:resource="http://example.org/hackathon#Topic"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#hasTopicHackathon -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#hasTopicHackathon">
        <rdfs:subPropertyOf rdf:resource="http://example.org/hackathon#hasTopic"/>
        <rdfs:domain rdf:resource="http://example.org/hackathon#Hackathon"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#hasTopicProject -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#hasTopicProject">
        <rdfs:subPropertyOf rdf:resource="http://example.org/hackathon#hasTopic"/>
        <rdfs:domain rdf:resource="http://example.org/hackathon#Project"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#isJudgedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#isJudgedBy">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Project"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Judge"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#isMentoredby -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#isMentoredby">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Team"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Mentor"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#isTeamOf -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#isTeamOf">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Team"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Hackathon"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#judges -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#judges">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Judge"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Project"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#memberOfTeam -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#memberOfTeam">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Participant"/>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Team"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#mentors -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#mentors">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Mentor"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Team"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#organizedBy -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#organizedBy">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Hackathon"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#requiresSkill -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#requiresSkill">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Project"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Skill"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/hackathon#worksOn -->

    <owl:ObjectProperty rdf:about="http://example.org/hackathon#worksOn">
        <rdfs:domain rdf:resource="http://example.org/hackathon#Team"/>
        <rdfs:range rdf:resource="http://example.org/hackathon#Project"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#broadMatch -->

    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broaderTransitive"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#semanticRelation"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Collection"/>
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
